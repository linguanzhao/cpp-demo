{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Hello World",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-Wpedantic",
				"${workspaceFolder}/main.cpp",
				"-o",
				"${workspaceFolder}/hello_world"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}